{
  "name": "@jobfill/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "build:debug": "tsc -p tsconfig.json && vite build --mode development --outDir dist-debug",
    "test-pages": "vite --config test-pages/vite.config.ts"
  },
  "dependencies": {
    "@jobfill/field-mapper": "*",
    "@jobfill/shared": "*",
    "@jobfill/types": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
