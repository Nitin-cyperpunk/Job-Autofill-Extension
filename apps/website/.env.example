# JobFill website settings. Copy to .env.local for local development, or add these in
# Vercel → Project → Settings → Environment Variables.
#
# All of these are PUBLIC values (they end up in the page HTML) — no secrets, API keys or
# passwords are needed. Anything left empty is hidden or shown as "coming soon".

# The site's own address, no trailing slash (canonical URLs, sitemap, social cards).
# Local: http://localhost:3000 — on Vercel: your production domain.
NEXT_PUBLIC_APP_URL=https://job-autofill-extension-nyqt.vercel.app

# Buy Me a Coffee page (the support page's button).
NEXT_PUBLIC_BUYMEACOFFEE_URL=https://buymeacoffee.com/nitinverse

# GitHub repository ("Star on GitHub", footer link, "Open an issue").
NEXT_PUBLIC_GITHUB_URL=https://github.com/Nitin-cyperpunk/Job-Autofill-Extension

# Google Search Console HTML-tag verification (only the content="…" value). Optional:
# leave empty if you verify another way. Never commit a token that isn't yours.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Chrome Web Store listing. Until set, "Add to Chrome" goes to /install.
NEXT_PUBLIC_CHROME_WEB_STORE_URL=

# Help/contact email shown on /support, /faq and /privacy. Hidden while empty.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional links (https:// only). Hidden while empty.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_TERMS_URL=
# Makes "Crafted by Nitinverse" in the footer a link.
NEXT_PUBLIC_CREATOR_URL=
